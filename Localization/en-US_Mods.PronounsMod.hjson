	They: {
		Subject: they
		Object: them
		Possessive: their
	}

	She: {
		Subject: she
		Object: her
		Possessive: her
	}

	He: {
		Subject: he
		Object: him
		Possessive: his
	}

	It: {
		Subject: it
		Object: it
		Possessive: its
	}
}

UI: {
	Unassigned: (no assigned pronouns!)
